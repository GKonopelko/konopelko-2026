---
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';

export interface Props {
  badgeText?: string;
  title?: string;
  subtitle?: string;
  buttonText?: string;
  buttonHref?: string;
  iconName?: string;
}

const {
  badgeText = 'Идет набор новых учеников',
  title = 'Готовы начать обучение?',
  subtitle = 'Свяжитесь со мной для консультации и пробного урока',
  buttonText = 'Записаться на пробный урок',
  buttonHref = '/contact/',
  iconName = 'calendar',
} = Astro.props;
---

<section class="cta-section">
  {badgeText && <div class="cta-badge">{badgeText}</div>}
  <h2>{title}</h2>
  {subtitle && <p class="cta-subtitle">{subtitle}</p>}
  <div class="cta-buttons">
    <Button href={buttonHref} variant="primary" size="large">
      <Icon name={iconName} size="sm" />
      {buttonText}
    </Button>
  </div>
</section>

<style>
  .cta-section {
    background: linear-gradient(135deg, var(--link-color), #4da6ff);
    color: var(--background-white);
    padding: 4rem 1.5rem;
    text-align: center;
    width: 100%;
    box-sizing: border-box;
    border-radius: var(--border-radius-lg);
  }

  .cta-badge {
    background: #ff4444;
    color: var(--background-white);
    padding: 0.5rem 1.5rem;
    border-radius: 2rem;
    display: inline-block;
    margin-bottom: 1rem;
    font-weight: 600;
  }

  .cta-section h2 {
    color: var(--background-white);
    margin-bottom: 1rem;
  }

  .cta-subtitle {
    max-width: 45rem;
    margin: 0 auto;
    line-height: 1.6;
  }

  .cta-buttons {
    margin-top: 2rem;
  }

  @media (max-width: 48rem) {
    .cta-section {
      padding: 2.5rem 1rem;
    }
  }

  @media (max-width: 30rem) {
    .cta-section {
      padding: 2rem 1rem;
    }

    .cta-badge {
      padding: 0.4rem 1rem;
      font-size: 0.9rem;
    }
  }
</style>
