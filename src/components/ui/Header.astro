---
import MobileMenu from './MobileMenu.astro';
import DesktopNav from './DesktopNav.astro';
import BurgerButton from './BurgerButton.astro';
import LogoLink from './LogoLink.astro';
import Button from './Button.astro';
import { getNavigationState } from '../../data/navigation';

interface Props {
  buttonId?: string;
  menuId?: string;
}

const { buttonId = 'headerBurger', menuId = 'mobileMenu' } = Astro.props;

const pathname = Astro.url.pathname;
const { lang, isTranslation, switchHref, switchText } = getNavigationState(pathname);

const langSwitcher = [
  { code: 'ru', label: 'RU', href: '/translation/' },
  { code: 'fi', label: 'FI', href: '/translation/fi/' },
  { code: 'en', label: 'EN', href: '/translation/en/' },
];
---

<header class="header">
  <div class="header-container">
    <div class="header-top">
      <LogoLink showText={true} />

      <div class="header-actions">
        {
          isTranslation && (
            <div class="lang-switcher desktop-lang" aria-label="Выбор языка">
              {langSwitcher.map((item) => (
                <Button
                  href={item.href}
                  variant="nav-link"
                  size="small"
                  class={`lang-btn ${lang === item.code ? 'is-active' : ''}`}
                >
                  {item.label}
                </Button>
              ))}
            </div>
          )
        }

        <Button href={switchHref} variant="soft" size="small" class="desktop-switch">
          {switchText}
        </Button>
        <BurgerButton {buttonId} {menuId} />
      </div>
    </div>

    <div class="header-bottom">
      <DesktopNav />
    </div>

    <div class="mobile-switch-bar">
      <Button href={switchHref} variant="soft" size="small" class="mobile-switch">
        {switchText}
      </Button>

      {
        isTranslation && (
          <div class="lang-switcher mobile-lang" aria-label="Выбор языка">
            {langSwitcher.map((item) => (
              <Button
                href={item.href}
                variant="nav-link"
                size="small"
                class={`lang-btn ${lang === item.code ? 'is-active' : ''}`}
              >
                {item.label}
              </Button>
            ))}
          </div>
        )
      }
    </div>
  </div>
  <MobileMenu {menuId} />
</header>

<script>
  import { initMobileMenu } from '../../scripts/mobile-menu';

  document.addEventListener('DOMContentLoaded', () => {
    initMobileMenu({
      buttonId: 'headerBurger',
      menuId: 'mobileMenu',
      breakpoint: 64,
      onOpen: () => {
        if (typeof window !== 'undefined' && window.gtag) {
          window.gtag('event', 'menu_open', {
            event_category: 'navigation',
            event_label: 'mobile_menu',
          });
        }
      },
    });
  });
</script>

<style>
  .header {
    background: var(--background-white);
    border-bottom: 0.0625rem solid var(--border-light);
    position: sticky;
    top: 0;
    z-index: 1002;
    backdrop-filter: blur(0.625rem);
    width: 100%;
  }

  .header-container {
    max-width: 75rem;
    margin: 0 auto;
    padding: 0.5rem 0.75rem;
  }

  .header-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
  }

  .lang-switcher {
    display: inline-flex;
    align-items: center;
    background: var(--background-light);
    border: 1px solid var(--border-light);
    border-radius: var(--border-radius-rounded);
    padding: 0.2rem;
    gap: 0.2rem;
  }

  .lang-switcher :global(.lang-btn) {
    padding: 0.3rem 0.65rem;
    font-size: var(--text-sm);
  }

  .header-actions :global(.desktop-switch),
  .header-bottom,
  .desktop-lang {
    display: none;
  }

  .mobile-switch-bar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding-top: 0.5rem;
    margin-top: 0.5rem;
    border-top: 0.0625rem solid var(--border-light);
  }

  .mobile-switch-bar :global(.mobile-switch) {
    flex: 1;
    min-width: 0;
  }

  .mobile-lang {
    flex-shrink: 0;
  }

  @media (min-width: 64rem) {
    .header-container {
      padding: 0.5rem 1rem;
    }

    .desktop-lang {
      display: inline-flex;
    }

    .mobile-switch-bar {
      display: none;
    }

    .header-actions :global(.desktop-switch) {
      display: inline-flex;
    }

    .header-bottom {
      display: flex;
      border-top: 0.0625rem solid var(--border-light);
      margin-top: 0.5rem;
      padding-top: 0.25rem;
    }
  }
</style>
