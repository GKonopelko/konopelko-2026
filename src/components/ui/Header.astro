---
import MobileMenu from './MobileMenu.astro';
import DesktopNav from './DesktopNav.astro';
import BurgerButton from './BurgerButton.astro';
import LogoLink from './LogoLink.astro';
import Button from './Button.astro';

interface Props {
  buttonId?: string;
  menuId?: string;
}

const { buttonId = 'headerBurger', menuId = 'mobileMenu' } = Astro.props;

// Определяем текущий раздел сайта
const pathname = Astro.url.pathname;
const isTranslation =
  pathname.startsWith('/translation') || pathname.startsWith('/fi') || pathname.startsWith('/en');

const switchHref = isTranslation ? '/' : '/translation/';
const desktopSwitchText = isTranslation
  ? '← Преподавание финского языка'
  : 'Услуги переводчика финского языка →';
const mobileSwitchText = isTranslation
  ? '← Изучаете финский? К урокам'
  : 'Нужен переводчик? В раздел →';
---

<header class="header">
  <div class="header-container">
    <div class="header-top">
      <LogoLink showText={true} />

      <div class="header-actions">
        <Button href={switchHref} variant="primary" size="small" class="desktop-switch switch-btn">
          {desktopSwitchText}
        </Button>
        <BurgerButton {buttonId} {menuId} />
      </div>
    </div>

    <div class="header-bottom">
      <DesktopNav />
    </div>

    <div class="mobile-switch-bar">
      <Button href={switchHref} variant="primary" size="small" class="mobile-switch switch-btn">
        {mobileSwitchText}
      </Button>
    </div>
  </div>
  <MobileMenu {menuId} />
</header>

<script>
  import { initMobileMenu } from '../../scripts/mobile-menu';

  document.addEventListener('DOMContentLoaded', () => {
    initMobileMenu({
      buttonId: 'headerBurger',
      menuId: 'mobileMenu',
      breakpoint: 64, // 1024px в rem
      onOpen: () => {
        if (typeof window !== 'undefined' && window.gtag) {
          window.gtag('event', 'menu_open', {
            event_category: 'navigation',
            event_label: 'mobile_menu',
          });
        }
      },
    });
  });
</script>

<style>
  /* === MOBILE FIRST (< 64rem) === */
  .header {
    background: var(--background-white);
    border-bottom: 0.0625rem solid var(--border-light);
    position: sticky;
    top: 0;
    z-index: 1002;
    backdrop-filter: blur(0.625rem);
    width: 100%;
  }

  .header-container {
    max-width: 75rem;
    margin: 0 auto;
    padding: 0.5rem 0.75rem;
  }

  .header-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
  }

  .header-actions :global(.desktop-switch),
  .header-bottom {
    display: none;
  }

  .mobile-switch-bar {
    padding-top: 0.5rem;
    margin-top: 0.5rem;
    border-top: 0.0625rem solid var(--border-light);
  }

  .mobile-switch-bar :global(.mobile-switch) {
    width: 100%;
  }

  /* Выделение кнопки-переключателя родной переменной */
  .header :global(.switch-btn) {
    background: var(--hover-bg);
  }

  /* === DESKTOP (≥ 64rem / 1024px) === */
  @media (min-width: 64rem) {
    .header-container {
      padding: 0.5rem 1rem;
    }

    .mobile-switch-bar {
      display: none;
    }

    .header-actions :global(.desktop-switch) {
      display: inline-flex;
    }

    .header-bottom {
      display: flex;
      border-top: 0.0625rem solid var(--border-light);
      margin-top: 0.5rem;
      padding-top: 0.25rem;
    }
  }
</style>
