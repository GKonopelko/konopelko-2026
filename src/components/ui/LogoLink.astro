---
import Button from './Button.astro';
import Logo from './Logo.astro';
import { getNavigationState } from '../../data/navigation';

export interface Props {
  showText?: boolean;
}

const { showText } = Astro.props;
const { lang } = getNavigationState(Astro.url.pathname);

const logoContent = {
  ru: {
    href: '/',
    title: 'Преподаватель и переводчик финского языка',
    subtitle: 'Конопелько Григорий Викторович',
    ariaLabel:
      'На главную страницу — Преподаватель и переводчик финского языка Конопелько Григорий Викторович',
  },
  fi: {
    href: '/translation/fi/',
    title: 'Venäjän kielen kääntäjä ja tulkki',
    subtitle: 'Grigori Konopelko',
    ariaLabel: 'Etusivulle — Venäjän ja suomen kielen kääntäjä ja tulkki Grigori Konopelko',
  },
  en: {
    href: '/translation/en/',
    title: 'Russian-English Translator & Interpreter',
    subtitle: 'Grigori Konopelko',
    ariaLabel: 'Home — Finnish-Russian-English Translator & Interpreter Grigori Konopelko',
  },
};

const currentLogo = logoContent[lang];
---

<Button
  href={currentLogo.href}
  variant="button-link"
  size="medium"
  class="logo-home-link"
  aria-label={currentLogo.ariaLabel}
>
  <div class="logo">
    <Logo />
    {
      showText && (
        <div class="logo-text">
          <span class="logo-title">{currentLogo.title}</span>
          <span class="logo-subtitle">{currentLogo.subtitle}</span>
        </div>
      )
    }
  </div>
</Button>

<style>
  .logo-home-link {
    text-decoration: none;
    padding: 0 1rem;
    flex-shrink: 1;
    min-width: 0;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: clamp(0.5rem, 2vw, 0.75rem);
    text-decoration: none;
    color: inherit;
    min-width: 0;
  }

  .logo-img {
    width: clamp(2rem, 8vw, 2.5rem);
    height: clamp(2rem, 8vw, 2.5rem);
    flex-shrink: 0;
  }

  .logo-text {
    display: flex;
    flex-direction: column;
    min-width: 0;
    flex: 1;
    width: 100%;
  }

  .logo-title {
    font-family: var(--font-heading);
    font-size: clamp(0.8rem, 4vw, 1.1rem);
    font-weight: 700;
    color: var(--link-color);
    line-height: 1.2;
    width: 100%;
    white-space: normal;
  }

  .logo-subtitle {
    font-size: clamp(0.6rem, 2.5vw, 0.75rem);
    color: var(--link-color);
    font-weight: 400;
    margin-top: 0.125rem;
    white-space: normal;
    width: 100%;
  }

  .logo:hover .logo-subtitle,
  .logo-home-link:hover .logo-subtitle {
    color: var(--text-primary);
  }

  /* Медиазапросы в rem */
  @media (max-width: 50rem) {
    /* 800px */
    .logo-title {
      font-size: 0.95rem;
    }
    .logo-subtitle {
      font-size: 0.7rem;
    }
    .logo-home-link {
      padding: 0 0.5rem 0 0;
    }
  }

  @media (max-width: 28.125rem) {
    /* 450px */
    .logo {
      gap: 0.45rem;
    }
    .logo-img {
      width: 1.85rem;
      height: 1.85rem;
    }
    .logo-title {
      font-size: 0.85rem;
    }
    .logo-subtitle {
      font-size: 0.65rem;
    }
  }

  @media (max-width: 25rem) {
    /* 400px */
    .logo-home-link {
      padding: 0;
    }
    .logo {
      gap: 0.35rem;
    }
    .logo-img {
      width: 1.65rem;
      height: 1.65rem;
    }
    .logo-title {
      font-size: 0.8rem;
    }
    .logo-subtitle {
      font-size: 0.6rem;
    }
  }

  @media (max-width: 21.875rem) {
    /* 350px */
    .logo {
      gap: 0.3rem;
    }
    .logo-img {
      width: 1.5rem;
      height: 1.5rem;
    }
    .logo-title {
      font-size: 0.75rem;
    }
    .logo-subtitle {
      font-size: 0.55rem;
    }
  }

  @media (max-width: 17.5rem) {
    /* 280px */
    .logo-img {
      display: none;
    }
    .logo {
      gap: 0;
    }
  }
</style>
