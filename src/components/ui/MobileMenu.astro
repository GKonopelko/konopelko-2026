---
import { getNavigationState } from '../../data/navigation';
import Button from './Button.astro';
import LogoLink from './LogoLink.astro';

interface Props {
  menuId: string;
}

const { menuId } = Astro.props;

const pathname = Astro.url.pathname;
const { links: currentLinks, switchHref, switchText } = getNavigationState(pathname);
---

<nav class="nav-mobile" id={menuId} aria-label="Мобильная навигация" aria-hidden="true">
  <div class="mobile-links">
    <LogoLink showText={false} />
    {
      currentLinks.map((link) => (
        <Button href={link.href} variant="button-link" size="large" class="nav-item">
          {link.label}
        </Button>
      ))
    }

    <Button href={switchHref} variant="soft" size="medium" class="nav-item--cta">
      {switchText}
    </Button>
  </div>
</nav>

<style>
  /* Стили оставьте без изменений */
  .nav-mobile {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 0;
    background: var(--background-white);
    z-index: 1001;
    transform: translateX(100%);
    transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    visibility: hidden;
    pointer-events: none;
  }

  .nav-mobile.active {
    height: 100dvh;
    transform: translateX(0);
    display: block;
    visibility: visible;
    pointer-events: auto;
  }

  .mobile-links {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin: 0 auto;
    padding-top: 6.5rem;
    padding-bottom: 2rem;
    max-width: 17.5rem;
    min-height: 100dvh;
    opacity: 0;
    transform: translateY(10px);
    transition: all 0.3s ease 0.2s;
    align-items: center;
  }

  .nav-mobile.active .mobile-links {
    opacity: 1;
    transform: translateY(0);
  }

  .mobile-links .nav-item {
    text-align: center;
  }

  .mobile-links :global(.nav-item--cta) {
    margin-top: auto;
    width: 100%;
  }

  @media (max-width: 30rem) {
    .nav-mobile {
      padding: 0 1.5rem;
    }

    .mobile-links {
      padding-top: 6rem;
      max-width: 16.25rem;
    }
  }

  @media (max-width: 22.5rem) {
    .nav-mobile {
      padding: 0 1rem;
    }

    .mobile-links {
      max-width: 15rem;
      padding-top: 5.5rem;
    }
  }
</style>
