---
import Button from './Button.astro';
import Icon from './Icon.astro';
---

<footer class="footer">
  <div class="footer-columns">
    <div class="footer-col">
      <h3 class="footer-title text-left">Обучение финскому языку</h3>
      <ul class="footer-list">
        <li><a href="/">Индивидуальные уроки</a></li>
        <li><a href="/metodika/">Методика преподавания</a></li>
        <li><a href="/about/">Обо мне и квалификация</a></li>
        <li><a href="/articles/?cat=learning">Полезные материалы</a></li>
        <li><a href="/faq/">Вопросы об обучении</a></li>
        <li><a href="/contact/">Запись на занятия</a></li>
      </ul>
    </div>

    <div class="footer-col">
      <h3 class="footer-title text-left">Услуги переводчика</h3>
      <ul class="footer-list">
        <li><a href="/translation/">Обзор услуг перевода</a></li>
        <li><a href="/translation/interpreting/">Устный перевод</a></li>
        <li><a href="/translation/written/">Письменный перевод</a></li>
        <li><a href="/translation/certification/">Заверение перевода</a></li>
        <li><a href="/translation/apostille/">Апостиль</a></li>
        <li><a href="/translation/price/">Стоимость перевода</a></li>
        <li><a href="/articles/?cat=translation">Заметки о финском языке</a></li>
        <li><a href="/translation/faq/">Вопросы о переводе</a></li>
        <li><a href="/translation/contact/">Заказать перевод</a></li>
      </ul>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="footer-contacts">
      <Button href="tel:+79117770297" variant="button-link" size="small">
        <Icon name="phone" size="sm" />
        <span class="contact-text">Позвонить</span>
      </Button>

      <Button href="mailto:grigori.konopelko@mail.ru" variant="button-link" size="small">
        <Icon name="email" size="sm" />
        <span class="contact-text">Написать</span>
      </Button>

      <Button
        href="https://wa.me"
        variant="button-link"
        size="small"
        target="_blank"
        rel="noopener noreferrer"
      >
        <Icon name="whatsapp" size="sm" />
        <span class="contact-text">WhatsApp</span>
      </Button>

      <Button
        href="https://t.me"
        variant="button-link"
        size="small"
        target="_blank"
        rel="noopener noreferrer"
      >
        <Icon name="telegram" size="sm" />
        <span class="contact-text">Telegram</span>
      </Button>

      <Button
        href="https://max.ru"
        variant="button-link"
        size="small"
        target="_blank"
        rel="noopener noreferrer"
      >
        <Icon name="max" size="sm" />
        <span class="contact-text">Max</span>
      </Button>
    </div>

    <p class="footer-copyright text-center">
      © Конопелько Григорий Викторович, {new Date().getFullYear()}
    </p>
  </div>
</footer>

<style>
  .footer {
    border-top: 0.0625rem solid var(--border-light);
    padding: 2rem 0 1.5rem;
    margin-top: 3rem;
  }

  .footer-columns {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem 3rem;
    margin-bottom: 2rem;
  }

  .footer-col {
    flex: 1 1 15rem;
  }

  .footer-title {
    font-size: var(--text-base);
    margin: 0 0 0.75rem;
  }

  .footer-list {
    list-style: none;
    padding: 0;
  }

  .footer-list a {
    color: var(--link-color);
    text-decoration: none;
    font-size: var(--text-sm);
    transition: var(--transition);
  }

  .footer-list a:hover {
    text-decoration: underline;
  }

  .footer-bottom {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
    padding-top: 1.5rem;
    border-top: 0.0625rem solid var(--border-light);
  }

  .footer-contacts {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
  }

  .contact-text {
    display: none;
  }

  .footer-copyright {
    font-size: var(--text-sm);
    margin: 0;
  }

  @media (min-width: 48rem) {
    .contact-text {
      display: inline;
    }
  }
</style>
