---
import { tutorLinks, translationLinks } from '../../data/navigation';
import Button from './Button.astro';

const pathname = Astro.url.pathname;
const isTranslation =
  pathname.startsWith('/translation') || pathname.startsWith('/fi') || pathname.startsWith('/en');

const currentLinks = isTranslation ? translationLinks : tutorLinks;
---

<nav class="nav-desktop" aria-label="Основная навигация">
  <div class="nav-links">
    {
      currentLinks.map((link) => {
        const isActive = pathname === link.href;
        return (
          <Button
            href={link.href}
            variant="nav-link"
            size="medium"
            class={isActive ? 'is-active' : ''}
          >
            {link.label}
          </Button>
        );
      })
    }
  </div>

  <style>
    .nav-desktop {
      display: none;
    }

    @media (min-width: 64rem) {
      .nav-desktop {
        display: flex;
      }

      .nav-links {
        display: flex;
        gap: 0.5rem;
        align-items: center;
      }

      .nav-links :global(.is-active) {
        background: var(--hover-bg);
        color: var(--text-primary);
      }
    }
  </style>
</nav>
