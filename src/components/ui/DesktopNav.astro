---
import { getNavigationState } from '../../data/navigation';
import Button from './Button.astro';

const pathname = Astro.url.pathname;
const { links: currentLinks } = getNavigationState(pathname);
---

<nav class="nav-desktop" aria-label="Основная навигация">
  <div class="nav-links">
    {
      currentLinks.map((link) => {
        const isActive = pathname === link.href.split('?')[0];
        return (
          <Button
            href={link.href}
            variant="nav-link"
            size="medium"
            class={isActive ? 'is-active' : ''}
          >
            {link.label}
          </Button>
        );
      })
    }
  </div>

  <style>
    .nav-desktop {
      display: none;
    }

    @media (min-width: 64rem) {
      .nav-desktop {
        display: flex;
      }

      .nav-links {
        display: flex;
        gap: 0.5rem;
        align-items: center;
      }
    }
  </style>
</nav>
