---
import { tutorLinks, translationLinks } from '../../data/navigation';
import Button from './Button.astro';

// Проверяем текущий адрес страницы
const pathname = Astro.url.pathname;
const isTranslation =
  pathname.startsWith('/translation') || pathname.startsWith('/fi') || pathname.startsWith('/en');

const currentLinks = isTranslation ? translationLinks : tutorLinks;
---

<nav class="nav-desktop" aria-label="Основная навигация">
  <div class="nav-links">
    {
      currentLinks.map((link) => (
        <Button href={link.href} variant="nav-link" size="medium">
          {link.label}
        </Button>
      ))
    }
  </div>

  <style>
    /* Mobile First: на узких экранах десктопное меню скрыто */
    .nav-desktop {
      display: none;
    }

    /* На широких экранах (≥ 64rem / 1024px) показываем горизонтальный ряд */
    @media (min-width: 64rem) {
      .nav-desktop {
        display: flex;
      }

      .nav-links {
        display: flex;
        gap: 0.5rem;
        align-items: center;
      }
    }
  </style>
</nav>
