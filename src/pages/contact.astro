---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/ui/Section.astro';
import FlexRow from '../components/ui/FlexRow.astro';
import Card from '../components/ui/Card.astro';
import FaqPreview from '../components/faq/FaqPreview.astro';
import ContactCards from '../components/sections/ContactCards.astro';
import { TUTOR_PRICES } from '../data/prices';

const pageTitle = 'Запись на уроки финского | Контакты репетитора Григория Конопелько';
const pageDescription =
  'Запишитесь на урок финского языка по тел. +7 911 777 02 97. Онлайн по всей России и очно в Санкт-Петербурге. WhatsApp, Telegram, Email. Удобное расписание.';

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: 'Контакты репетитора финского языка',
  description: pageDescription,
  url: new URL(Astro.url.pathname, Astro.site).href,
  mainEntity: {
    '@type': 'ProfessionalService',
    name: 'Репетитор финского языка - Григорий Конопелько',
    contactPoint: {
      '@type': 'ContactPoint',
      telephone: '+7-911-777-02-97',
      email: 'grigori.konopelko@mail.ru',
      address: {
        '@type': 'PostalAddress',
        addressCountry: 'RU',
        addressLocality: 'Санкт-Петербург',
      },
      contactType: 'customer service',
      areaServed: ['RU', 'FI'],
      availableLanguage: ['Russian', 'Finnish'],
      hoursAvailable: {
        '@type': 'OpeningHoursSpecification',
        dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
        opens: '09:00',
        closes: '21:00',
      },
    },
  },
};

const contactQuestions = [
  {
    question: 'Сколько стоят занятия?',
    answer: `Индивидуальные онлайн-уроки — ${TUTOR_PRICES.onlineLesson}. Занятия в паре — ${TUTOR_PRICES.pairLesson}. Очно в Санкт-Петербурге — стоимость рассчитывается индивидуально.`,
  },
  {
    question: 'Какой график занятий?',
    answer:
      'Гибкий график: утренние, дневные или вечерние занятия 2–3 раза в неделю. Рекомендую сдвоенные уроки по 120 минут 2 раза в неделю. Работаю с 9:00 до 21:00 по московскому времени.',
  },
  {
    question: 'Есть ли пробный урок?',
    answer:
      'Бесплатного урока нет. На первом уроке определяем ваш уровень, цели изучения и составляем индивидуальный план обучения. Это полноценное занятие с диагностикой и построением программы.',
  },
];
---

<BaseLayout title={pageTitle} description={pageDescription} structuredData={structuredData}>
  <Section>
    <h1>Контакты и запись на занятия</h1>
    <p class="text-center">
      Напишите мне в мессенджер, на электронную почту или позвоните. Отвечаю ежедневно с 9:00 до
      21:00 (МСК).
    </p>

    <ContactCards />

    <FlexRow>
      <Card>
        <h3>Что указать в первом сообщении для быстрой записи:</h3>
        <ul>
          <li>
            <strong>Цель обучения:</strong> финский с нуля, подготовка к YKI-тесту, поступление в вуз
            Финляндии или помощь со школьной программой.
          </li>
          <li>
            <strong>Текущий уровень:</strong> изучали ли язык раньше и по каким учебникам.
          </li>
          <li>
            <strong>Удобный график:</strong> желаемые дни недели, время (по Москве) и формат (онлайн или
            очно в Санкт-Петербурге).
          </li>
        </ul>
      </Card>

      <Card>
        <h3>Формат и условия проведения занятий:</h3>
        <ul>
          <li>
            <strong>Онлайн-платформы:</strong> занятия проходят в Google Meet, все учебники и аудиоматериалы
            предоставляю в электронном виде.
          </li>
          <li>
            <strong>Оплата занятий:</strong> принимается в российских рублях (перевод через СБП или на
            карту российского банка).
          </li>
          <li>
            <strong>Перенос и отмена:</strong> предупредить об изменении времени необходимо минимум за
            24 часа до начала урока.
          </li>
        </ul>
      </Card>
    </FlexRow>

    <Card variant="wide-accent">
      <h3>Почему выбирают меня:</h3>
      <p>
        Преподаватель финского языка с опытом работы более 15 лет. Эффективно подтягиваю школьный
        финский, готовлю к YKI-тесту, поступлению в вузы Финляндии и учу с нуля. Результат
        достигается благодаря разговорной практике, системной грамматике и индивидуальному подходу.
      </p>
    </Card>
  </Section>

  <Section background="light">
    <FaqPreview
      title="Часто спрашивают о финском"
      questions={contactQuestions}
      showMoreLink="/faq/"
      limit={3}
    />
  </Section>
</BaseLayout>
