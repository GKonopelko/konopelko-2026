---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/ui/Section.astro';
import Card from '../../components/ui/Card.astro';
import Button from '../../components/ui/Button.astro';
import CTASection from '../../components/sections/CTASection.astro';

export async function getStaticPaths() {
  const articleEntries = await getCollection('articles', ({ data }) => {
    return data.lang === 'ru';
  });

  return articleEntries.map((entry) => {
    const cleanSlug = entry.id.split('/').pop().replace(/\.md$/, '');
    return {
      params: { slug: cleanSlug },
      props: { entry, cleanSlug },
    };
  });
}

const { entry, cleanSlug } = Astro.props;
const { Content } = await entry.render();

const pageTitle = entry.data.title;
const pageDescription = entry.data.description || 'Полезные материалы от Григория Конопелько';
const canonicalUrl = `https://konopelko.com{cleanSlug}/`;
const isTranslation = entry.data.category === 'translation';
---

<BaseLayout title={pageTitle} description={pageDescription} canonicalUrl={canonicalUrl}>
  <Section>
    <Button
      href={isTranslation ? '/articles/?cat=translation' : '/articles/?cat=learning'}
      size="small"
      variant="soft"
    >
      ← Назад к материалам
    </Button>
  </Section>

  <Section>
    <Card variant="wide">
      <h1>{entry.data.title}</h1>
      <div class="prose">
        <Content />
      </div>
    </Card>
  </Section>

  {
    isTranslation ? (
      <CTASection
        badgeText="Опыт работы более 15 лет"
        title="Нужен устный или письменный перевод?"
        subtitle="Свяжитесь со мной удобным способом, чтобы обсудить вашу задачу."
        buttonText="Связаться с переводчиком"
        buttonHref="/translation/contact/"
      />
    ) : (
      <Section background="light">
        <Card variant="wide">
          <h3>Сложно учить финский в одиночку?</h3>
          <p>Обращайтесь, помогу разложить всё по полочкам.</p>
          <Button href="/contact/" size="medium">
            Разобраться вместе
          </Button>
        </Card>
      </Section>
    )
  }
</BaseLayout>
