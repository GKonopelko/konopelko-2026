---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/ui/Section.astro';
import Card from '../../components/ui/Card.astro';

const allArticles = await getCollection('articles', ({ data }) => {
  return (data.category === 'learning' || data.category === 'both') && data.lang === 'ru';
});
const sortedArticles = [...allArticles].sort(
  (a, b) => (a.data.order || 100) - (b.data.order || 100)
);

const pageTitle = 'Полезные статьи по изучению финского языка | Григорий Конопелько';
const pageDescription =
  'Авторские разборы, методики и практические советы по преодолению языкового барьера, подготовке к YKI и адаптации в финской школе.';
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <Section background="light">
    <h1>Полезные материалы</h1>
    <p class="text-center">
      Практические советы филолога для взрослых и родителей школьников, обучающихся в Финляндии.
    </p>
  </Section>

  <Section>
    {
      sortedArticles.map((article) => (
        <Card variant="wide" href={`/articles/${article.slug}/`}>
          <h3 class="text-left article-title">{article.data.title} →</h3>
          {article.data.description && (
            <p class="text-left article-desc">{article.data.description}</p>
          )}
        </Card>
      ))
    }
  </Section>
</BaseLayout>

<style>
  .article-title,
  .article-desc {
    width: 100%;
  }

  .article-desc {
    margin-bottom: 0;
  }
</style>
