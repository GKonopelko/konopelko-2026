---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/ui/Section.astro';
import FlexRow from '../../components/ui/FlexRow.astro';
import Card from '../../components/ui/Card.astro';
import FaqPreview from '../../components/faq/FaqPreview.astro';
import ContactCards from '../../components/sections/ContactCards.astro';
import { TRANSLATION_PRICES } from '../../data/prices';

const pageTitle = 'Заказать перевод и контакты | Переводчик Григорий Конопелько';
const pageDescription =
  'Заказать устный или письменный перевод с финского и английского языков. Отправьте документ на оценку по email, в Telegram или WhatsApp. Санкт-Петербург и онлайн.';

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: 'Контакты переводчика финского языка',
  description: pageDescription,
  url: new URL(Astro.url.pathname, Astro.site).href,
  mainEntity: {
    '@type': 'ProfessionalService',
    name: 'Переводчик финского и английского языков — Григорий Конопелько',
    contactPoint: {
      '@type': 'ContactPoint',
      telephone: '+7-911-777-02-97',
      email: 'grigori.konopelko@mail.ru',
      address: {
        '@type': 'PostalAddress',
        addressCountry: 'RU',
        addressLocality: 'Санкт-Петербург',
      },
      contactType: 'customer service',
      areaServed: ['RU', 'FI'],
      availableLanguage: ['Russian', 'Finnish', 'English'],
      hoursAvailable: {
        '@type': 'OpeningHoursSpecification',
        dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
        opens: '09:00',
        closes: '21:00',
      },
    },
  },
};

const contactQuestions = [
  {
    question: 'Как заказать письменный перевод и узнать точную цену?',
    answer: `Отправьте файл, скан или фото документа по электронной почте или в мессенджер. Я оценю точную стоимость (${TRANSLATION_PRICES.writtenPerWord}) и сроки. После согласования и оплаты вы получите готовый перевод в срок.`,
  },
  {
    question: 'Как быстро выполняется перевод документов?',
    answer:
      'Небольшие личные документы (свидетельства, справки, дипломы) обычно переводятся за 1 рабочий день, иногда — в день обращения. Нотариальное заверение занимает 1 рабочий день.',
  },
  {
    question: 'Какие способы оплаты доступны?',
    answer:
      'Оплата принимается в российских рублях переводом через СБП или на карту российского банка. С новыми клиентами работа ведется по предоплате.',
  },
];
---

<BaseLayout title={pageTitle} description={pageDescription} structuredData={structuredData}>
  <Section>
    <h1>Контакты и заказ перевода</h1>
    <p class="text-center">
      Для оценки стоимости и сроков письменного перевода вышлите файл, скан или фото удобным для вас
      способом. Отвечаю ежедневно с 9:00 до 21:00 (МСК).
    </p>

    <ContactCards emailNote="Удобно для отправки файлов на оценку" />

    <FlexRow>
      <Card>
        <h3>Что указать при обращении для быстрой оценки:</h3>
        <ul>
          <li>
            <strong>Для письменного перевода:</strong> прикрепите документ (PDF, Word, фото или скан),
            укажите желаемый срок и нужно ли нотариальное заверение.
          </li>
          <li>
            <strong>Для устного перевода и звонков в Финляндию:</strong> напишите дату, время (по Москве),
            формат (онлайн, по телефону/громкой связи или выезд в Санкт-Петербурге) и тематику разговора.
          </li>
          <li>
            <strong>Оплата:</strong> расчет производится в российских рублях (перевод через СБП или на
            карту российского банка).
          </li>
        </ul>
      </Card>

      <Card>
        <h3>Передача оригиналов и доставка готовых документов</h3>
        <ul>
          <li>
            <strong>В Санкт-Петербурге:</strong> личная встреча для передачи оригиналов на нотариальное
            заверение по предварительной договоренности.
          </li>
          <li>
            <strong>По России и в Финляндию:</strong> готовые заверенные переводы отправляю курьерской
            службой СДЭК или почтой. Электронные версии и сканы высылаю на почту и в мессенджеры в день
            готовности.
          </li>
        </ul>
      </Card>
    </FlexRow>

    <Card variant="wide-accent">
      <h3>Почему стоит обратиться напрямую:</h3>
      <p>
        Работаю напрямую с частными клиентами без посредников и агентских наценок. Дипломированный
        филолог и переводчик (СПбГУ) с опытом работы более 15 лет. Выполняю письменные переводы с
        нотариальным заверением, а также устный перевод на встречах, в онлайн-формате и по телефону.
      </p>
    </Card>
  </Section>

  <Section background="light">
    <FaqPreview
      title="Часто спрашивают о переводе"
      questions={contactQuestions}
      showMoreLink="/translation/faq/"
      limit={3}
    />
  </Section>
</BaseLayout>
