---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/ui/Section.astro';
import FlexRow from '../../components/ui/FlexRow.astro';
import Card from '../../components/ui/Card.astro';
import Icon from '../../components/ui/Icon.astro';
import Button from '../../components/ui/Button.astro';
import CTASection from '../../components/sections/CTASection.astro';
import { TRANSLATION_PRICES } from '../../data/prices';

const pageTitle = 'Письменный перевод на финский и английский языки | Григорий Конопелько';
const pageDescription =
  'Качественные письменные переводы на финский и английский языки и с финского и английского на русский по адекватной цене. Нотариальное заверение и печать переводчика.';

const translationAreas = [
  {
    sphere: 'Личная',
    examples: 'Письма, резюме, отзывы, рекомендации',
  },
  {
    sphere: 'Административная',
    examples:
      'Паспорта, свидетельства, аттестаты, дипломы, трудовые книжки, справки, права, лицензии',
  },
  {
    sphere: 'Бизнес',
    examples:
      'Договоры, счета, акты, выписки из реестра, учредительные документы, уставы, свидетельства, декларации, протоколы собраний акционеров',
  },
  {
    sphere: 'Медицина',
    examples:
      'Диагнозы, выписки, направления, истории болезней, рецепты, результаты анализов, назначения',
  },
  {
    sphere: 'Экономика',
    examples: 'Коммерческие предложения, договоры',
  },
  {
    sphere: 'Реклама и маркетинг',
    examples: 'Брошюры, рекламные статьи, слоганы',
  },
  {
    sphere: 'Недвижимость',
    examples:
      'Договоры купли-продажи, выписки из реестров, отчеты о проверке состояния объектов недвижимости',
  },
  {
    sphere: 'Бухгалтерия и страхование',
    examples: 'Годовые отчеты, балансы, страховые полисы и договоры страхования',
  },
  {
    sphere: 'Техника',
    examples: 'Документация, протоколы, проекты, технологические карты',
  },
  {
    sphere: 'Строительство',
    examples: 'Проектная документация, акты выполненных работ, технические отчеты и сметы',
  },
  {
    sphere: 'Экология',
    examples: 'Описания проектов, экологические нормы',
  },
  {
    sphere: 'Право',
    examples: 'Иски, переписка, решения суда, постановления, апелляции',
  },
  {
    sphere: 'Энергетика',
    examples: 'Протоколы, проекты',
  },
  {
    sphere: 'Туризм и рестораны',
    examples: 'Сайты гостиниц и ресторанов, рецепты и меню',
  },
];
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <Section>
    <h1>Письменный перевод: финский, русский, английский</h1>
    <p class="text-center">
      Перевод в обоих направлениях: <strong>с финского и английского на русский</strong>, а также <strong
        >с русского на финский и английский</strong
      >
    </p>

    <p class="text-center">
      <strong>Нужен качественный перевод? — Обращайтесь!</strong>
    </p>

    <FlexRow>
      <Button href="/translation/contact/" variant="primary" size="large">
        Заказать перевод →
      </Button>
      <Button href="/translation/price/" variant="button-link" size="large">
        Стоимость письменного перевода
      </Button>
    </FlexRow>
  </Section>

  <Section background="light">
    <h2>Контроль качества и официальные документы</h2>
    <p>
      Я тщательнейшим образом слежу за качеством перевода. Все переводы, предназначенные для
      публикации, проверяются корректором-носителем языка, поэтому вы получите качественные переводы
      не только с финского и английского языков на русский, но и с русского языка на финский и
      английский.
    </p>
    <p>
      Осуществляю комплексный перевод документов для подачи в
      <a href="/translation/faq/#acceptTranslation">посольство</a> Финляндии, для оформления
      <a href="/translation/faq/#residensePermite">разрешения на пребывание (ВНЖ)</a> и для поступления
      на учебу в Финляндию, для
      <a href="/translation/faq/#recruitingOffice">военкомата</a>, налоговой инспекции, для банков и
      т.п.
    </p>
    <p>Перевожу интернет-сайты разнообразных тематик и интерфейсы программ.</p>
  </Section>

  <Section>
    <h2>Официальное заверение переводов</h2>
    <FlexRow>
      <Card>
        <Icon name="award" />
        <h3>Нотариальное заверение</h3>
        <p>
          Делаю нотариальное заверение переводов с финского и английского языков на русский. Обычно
          оно требуется при переводе официальных свидетельств, свидетельств о рождении и браке,
          аттестатов, дипломов и выписок из торговых реестров.
        </p>
        <Button href="/translation/certification/" variant="text-link"
          >Подробнее о заверении →</Button
        >
      </Card>

      <Card>
        <Icon name="bookOpen" />
        <h3>Заверение печатью переводчика</h3>
        <p>
          Заверяю переводы печатью переводчика. Такое заверение чаще всего используется при переводе
          официальных свидетельств с русского языка на финский или английский для подачи в ведомства
          Финляндии.
        </p>
        <Button href="/translation/certification/" variant="text-link"
          >Подробнее о заверении →</Button
        >
      </Card>
    </FlexRow>
  </Section>

  <Section background="light">
    <h2>Примеры областей, в которых у меня имеется опыт перевода</h2>
    <FlexRow>
      {
        translationAreas.map((item) => (
          <Card>
            <h3>{item.sphere}</h3>
            <p>{item.examples}</p>
          </Card>
        ))
      }
    </FlexRow>
  </Section>

  <CTASection
    badgeText={TRANSLATION_PRICES.writtenPerWord}
    title="Нужно перевести или заверить документы?"
    subtitle="Вышлите файл, скан или фото документа по электронной почте grigori.konopelko@mail.ru, в Telegram или WhatsApp для точного расчета стоимости и сроков."
    buttonText="Отправить документ на оценку"
    buttonHref="/translation/contact/"
  />
</BaseLayout>
