---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/ui/Section.astro';
import FlexRow from '../../components/ui/FlexRow.astro';
import Card from '../../components/ui/Card.astro';
import Icon from '../../components/ui/Icon.astro';
import Button from '../../components/ui/Button.astro';
import CTASection from '../../components/sections/CTASection.astro';
import { TRANSLATION_PRICES } from '../../data/prices';

const pageTitle = 'Письменный перевод на финский и английский языки | Григорий Конопелько';
const pageDescription = `Качественные письменные переводы с финского и английского языков на русский и обратно. Стандартный документ ${TRANSLATION_PRICES.standardDoc}, нестандартный текст ${TRANSLATION_PRICES.writtenPerWord}. Нотариальное заверение в Санкт-Петербурге.`;

const translationAreas = [
  {
    sphere: 'Личные и административные документы',
    examples:
      'паспорта, свидетельства о рождении и браке, дипломы, аттестаты, трудовые книжки, справки о несудимости, водительские права, резюме и рекомендации.',
  },
  {
    sphere: 'Бизнес, финансы и страхование',
    examples:
      'договоры, контракты, счета, акты, выписки из торгового реестра (Kaupparekisteri), уставы, годовые отчеты, балансы, декларации и страховые полисы.',
  },
  {
    sphere: 'Право и судебные документы',
    examples:
      'исковые заявления, судебные решения, постановления, апелляции, доверенности, согласия на выезд ребенка и официальная переписка.',
  },
  {
    sphere: 'Медицина и фармацевтика',
    examples:
      'выписки из истории болезни, диагнозы, направления, результаты обследований и анализов, рецепты и рекомендации для клиник Финляндии и России.',
  },
  {
    sphere: 'Техника, строительство и энергетика',
    examples:
      'инструкции по эксплуатации, спецификации, проектная документация, сметы, акты выполненных работ, технологические карты и экологические нормы.',
  },
  {
    sphere: 'Недвижимость, туризм и IT',
    examples:
      'договоры купли-продажи, отчеты о состоянии объектов, сайты компаний и отелей, меню ресторанов, рекламные материалы и интерфейсы программ.',
  },
];
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <Section>
    <h1>Письменный перевод: финский, русский, английский</h1>
    <p class="text-center">
      Перевод в обоих направлениях: <strong>с финского и английского на русский</strong>, а также <strong
        >с русского на финский и английский</strong
      >
    </p>

    <p class="text-center">
      <strong>Нужен качественный перевод в срок? — Обращайтесь напрямую без посредников!</strong>
    </p>

    <FlexRow>
      <Button href="/translation/contact/" variant="primary" size="large">
        Заказать перевод →
      </Button>
      <Button href="/translation/price/" variant="button-link" size="large">
        Стоимость письменного перевода
      </Button>
    </FlexRow>
  </Section>

  <Section background="light">
    <h2>Контроль качества и официальные документы</h2>
    <p>
      Я тщательнейшим образом слежу за точностью терминологии, имен собственных, дат и цифр. Все
      переводы, предназначенные для публикации, при необходимости проверяются корректором-носителем
      языка, поэтому вы получаете безупречный текст как при переводе на русский, так и при переводе
      на финский и английский языки.
    </p>
    <p>
      Выполняю комплексный перевод документов для подачи в
      <a href="/translation/faq/#acceptTranslation">посольство и консульство</a> Финляндии, для оформления
      <a href="/translation/faq/#residensePermite">разрешения на пребывание (ВНЖ в Migri)</a> и поступления
      на учебу в Финляндию, для
      <a href="/translation/faq/#recruitingOffice">военкомата</a>, налоговой инспекции (Vero),
      ЗАГСа, банков и нотариусов.
    </p>
  </Section>

  <Section>
    <h2>Официальное заверение переводов</h2>
    <FlexRow>
      <Card>
        <Icon name="award" />
        <h3>Нотариальное заверение</h3>
        <p>
          Оформляю нотариальное заверение переводов с финского и английского языков на русский в
          Санкт-Петербурге ({TRANSLATION_PRICES.notaryCertification}). Требуется для паспортов,
          свидетельств ЗАГС, дипломов, доверенностей и выписок из торговых реестров.
        </p>
        <Button href="/translation/certification/" variant="text-link"
          >Подробнее о заверении →</Button
        >
      </Card>

      <Card>
        <Icon name="bookOpen" />
        <h3>Заверение печатью переводчика</h3>
        <p>
          Заверяю переводы своей печатью дипломированного переводчика и подписью. Такой формат чаще
          всего используется при переводе документов с русского языка на финский или английский для
          ведомств Финляндии, вузов и банков.
        </p>
        <Button href="/translation/certification/" variant="text-link"
          >Подробнее о заверении →</Button
        >
      </Card>
    </FlexRow>
  </Section>

  <Section background="light">
    <h2>Основные тематики письменного перевода</h2>
    <ul>
      {
        translationAreas.map((item) => (
          <li>
            <strong>{item.sphere}:</strong> {item.examples}
          </li>
        ))
      }
    </ul>
  </Section>

  <Section>
    <h2>Сроки выполнения и получение перевода</h2>
    <ul>
      <li>
        <strong>Стандартные сроки:</strong> личные документы (свидетельства, справки, дипломы) обычно
        переводятся за <strong>1 рабочий день</strong>, при небольшой загрузке — в день обращения.
        Нотариальное заверение занимает 1 рабочий день.
      </li>
      <li>
        <strong>Удобное получение:</strong> электронные файлы и сканы с печатью отправляю на электронную
        почту в день готовности. Бумажные оригиналы передаю лично в Санкт-Петербурге или отправляю курьерской
        службой СДЭК по России.
      </li>
    </ul>
  </Section>

  <CTASection
    badgeText={`Стандартный документ ${TRANSLATION_PRICES.standardDoc} • Нестандартный текст ${TRANSLATION_PRICES.writtenPerWord}`}
    title="Нужно перевести или заверить документы?"
    subtitle="Вышлите файл, скан или фото документа по электронной почте grigori.konopelko@mail.ru для точного расчета стоимости и сроков."
    buttonText="Отправить документ на оценку"
    buttonHref="/translation/contact/"
  />
</BaseLayout>
