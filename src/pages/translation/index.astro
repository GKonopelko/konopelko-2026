---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/ui/Section.astro';
import FlexRow from '../../components/ui/FlexRow.astro';
import Card from '../../components/ui/Card.astro';
import Icon from '../../components/ui/Icon.astro';
import Button from '../../components/ui/Button.astro';
import FaqPreview from '../../components/faq/FaqPreview.astro';
import CTASection from '../../components/sections/CTASection.astro';
import TranslatorExperience from '../../components/sections/TranslatorExperience.astro';
import ContactCards from '../../components/sections/ContactCards.astro';
import { TRANSLATION_PRICES } from '../../data/prices';

const pageTitle = 'Переводчик финского языка в Санкт-Петербурге | Григорий Конопелько';
const pageDescription = `Качественные письменные и устные переводы на финский язык и с финского языка напрямую от переводчика. Оперативно и по приемлемым ценам. Письменный ${TRANSLATION_PRICES.standardDoc}, устный ${TRANSLATION_PRICES.interpretingPerHour}.`;

const translationQuestions = [
  {
    question: 'Как рассчитывается стоимость письменного перевода?',
    answer: `<p>Стоимость определяется типом и сложностью текста. Перевод стандартного личного документа — ${TRANSLATION_PRICES.standardDoc}, нестандартных текстов — ${TRANSLATION_PRICES.writtenPerWord} (${TRANSLATION_PRICES.writtenPerPage} с базовой корректурой и форматированием).</p>`,
  },
  {
    question: 'Можно ли сделать нотариально заверенный перевод?',
    answer: `<p>Да, я оформляю нотариально заверенные переводы (${TRANSLATION_PRICES.notaryCertification}). Срок выполнения — обычно 1 рабочий день.</p>`,
  },
  {
    question: 'В каком виде принимаются и выдаются файлы?',
    answer:
      '<p>Принимаю редактируемые форматы (doc, docx, rtf), а также сканы и фото документов. Готовый перевод отправляю по электронной почте или передаю лично в Санкт-Петербурге (возможна отправка СДЭК по России).</p>',
  },
];
---

<BaseLayout title={pageTitle} description={pageDescription} faqData={translationQuestions}>
  <Section>
    <h1>Переводчик финского языка в Санкт-Петербурге — Григорий Конопелько</h1>
    <p class="text-center">
      <strong
        >Качественный перевод на финский язык и с финского языка, без посредников по разумной цене</strong
      >
    </p>
    <p class="text-center">
      финский – русский – финский • английский – русский – английский • финский – английский –
      финский
    </p>

    <FlexRow>
      <Card>
        <Icon name="bookOpen" />
        <h3>Письменный перевод</h3>
        <p>Официальные документы, личные справки, общие и специальные тексты</p>
        <p><strong>{TRANSLATION_PRICES.standardDoc}</strong></p>
        <Button href="/translation/written/" variant="text-link">Подробнее →</Button>
      </Card>

      <Card>
        <Icon name="users" />
        <h3>Устный перевод</h3>
        <p>Последовательный и синхронный перевод в Санкт-Петербурге, онлайн и по телефону</p>
        <p><strong>{TRANSLATION_PRICES.interpretingPerHour}</strong></p>
        <Button href="/translation/interpreting/" variant="text-link">Подробнее →</Button>
      </Card>
    </FlexRow>

    <FlexRow>
      <Button href="/translation/contact/" variant="primary" size="large">
        Заказать перевод →
      </Button>
      <Button href="/translation/price/" variant="button-link" size="large">
        Стоимость перевода и услуг
      </Button>
    </FlexRow>
  </Section>

  <Section background="light">
    <h2>Индивидуальный подход и комплексное обслуживание</h2>
    <p>
      Выполняю письменные и устные переводы, предлагая комплексное обслуживание от текста до
      нотариального заверения и апостиля с использованием современных словарей и CAT-программ. <strong
        >Давайте работать вместе!</strong
      >
    </p>
  </Section>

  <Section>
    <h2>Какие документы и мероприятия я перевожу</h2>
    <p class="text-center">
      Работаю как с частными лицами, так и с российскими и финскими компаниями. Выполняю переводы
      любой сложности с соблюдением строгой конфиденциальности.
    </p>

    <h3>Письменные переводы</h3>
    <ul>
      <li>
        <strong>Личные документы для ЗАГС, виз и ВНЖ:</strong> паспорта, свидетельства о рождении и браке,
        справки о несудимости, дипломы, аттестаты, трудовые книжки.
      </li>
      <li>
        <strong>Юридические и финансовые тексты:</strong> договоры, контракты, уставы компаний, доверенности,
        судебные решения, выписки из торгового реестра (Kaupparekisteri).
      </li>
      <li>
        <strong>Техническая и деловая документация:</strong> инструкции по эксплуатации, спецификации,
        строительные проекты, таможенные декларации, деловая переписка и сайты.
      </li>
      <li>
        <strong>Медицинские документы:</strong> выписки из истории болезни, результаты обследований, справки
        для лечения в клиниках Финляндии и России.
      </li>
    </ul>

    <h3>Устный перевод и сопровождение</h3>
    <ul>
      <li>
        <strong>Официальные инстанции:</strong> перевод у нотариуса в Санкт-Петербурге, в ЗАГСе, в суде,
        на таможне, в банках и государственных учреждениях.
      </li>
      <li>
        <strong>Дистанционный перевод и звонки в Финляндию:</strong> сопровождение видеоконференций (Яндекс
        Телемост, Google Meet, Zoom), а также помощь по телефону на приеме у врача, в банке или Kela.
      </li>
      <li>
        <strong>Деловые переговоры и выставки:</strong> последовательный и синхронный перевод на встречах
        с партнерами, форумах, семинарах и презентациях.
      </li>
      <li>
        <strong>Командировки и пусконаладка:</strong> устный перевод на производственных площадках, при
        монтаже оборудования и в деловых поездках по Финляндии и России.
      </li>
    </ul>
  </Section>

  <Section background="light">
    <h2>Как строится работа</h2>
    <ol>
      <li>
        <strong>Оценка заказа:</strong> вы отправляете документ (скан, фото или файл) по электронной почте
        или в мессенджер. Я оцениваю точную стоимость и сроки в течение 15–30 минут.
      </li>
      <li>
        <strong>Согласование:</strong> подтверждаем стоимость, сроки и способ получения готового перевода.
        При необходимости согласовываем специальную терминологию.
      </li>
      <li>
        <strong>Перевод и вычитка:</strong> выполняю перевод с сохранением исходного форматирования документа,
        провожу тщательную редактуру и проверку всех имен, дат и цифр.
      </li>
      <li>
        <strong>Передача и заверение:</strong> отправляю готовый файл по электронной почте или передаю
        распечатанный и нотариально заверенный экземпляр лично в Санкт-Петербурге.
      </li>
    </ol>
  </Section>

  <TranslatorExperience />

  <Section>
    <FaqPreview
      title="Часто спрашивают о переводе"
      questions={translationQuestions}
      showMoreLink="/translation/faq/"
    />
  </Section>

  <Section background="light">
    <h2>Связаться для оценки заказа</h2>
    <p class="text-center">
      Отправьте документ любым удобным способом — я быстро рассчитаю точную стоимость и сроки
      выполнения.
    </p>
    <ContactCards emailNote="Отправьте файл, скан или фото документа для расчета стоимости" />
  </Section>

  <CTASection
    badgeText="Санкт-Петербург и онлайн по всему миру"
    title="Нужен точный перевод в срок?"
    subtitle="Для оценки стоимости и сроков письменного перевода вышлите файл, скан или фото"
    buttonText="Отправить документ на оценку"
    buttonHref="/translation/contact/"
  />
</BaseLayout>
