---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/ui/Section.astro';
import FaqSection from '../components/faq/FaqSection.astro';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { parseQuestions } from '../lib/markdown';

const faqCategories = await getCollection('faq', ({ data }) => data.category === 'learning');
const sortedCategories = faqCategories.sort(
  (a: CollectionEntry<'faq'>, b: CollectionEntry<'faq'>) => a.data.order - b.data.order
);

const categoriesWithQuestions = sortedCategories.map((category) => ({
  ...category,
  questions: parseQuestions(category.body),
}));

const pageTitle = 'Частые вопросы по изучению финского языка | Репетитор Григорий Конопелько';
const pageDescription =
  'Ответы на частые вопросы: подготовка к YKI, стоимость занятий, обучение с нуля, методика преподавания финского языка';
const canonicalUrl = 'https://konopelko.com';
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl={canonicalUrl}
  faqData={categoriesWithQuestions.flatMap((cat) => cat.questions)}
>
  <Section>
    <h1>Ответы на часто задаваемые вопросы по изучению финского языка</h1>
  </Section>

  {
    categoriesWithQuestions.map((category, index) => {
      const background = index % 2 === 0 ? 'white' : 'light';
      return (
        <Section background={background}>
          <h2>{category.data.title}</h2>
          {category.data.description && <p class="text-center">{category.data.description}</p>}
          <FaqSection questions={category.questions} />
        </Section>
      );
    })
  }

  <Section>
    <h2>Остались вопросы?</h2>
    <p class="text-center">
      Напишите или позвоните мне — с радостью отвечу и помогу с выбором программы обучения!
    </p>
  </Section>
</BaseLayout>
