---
import Header from '../components/ui/Header.astro';
import Footer from '../components/ui/Footer.astro';
import favicon from '@assets/images/parrotsvg.svg';
import Analytics from '../components/analytics/Analytics.astro';
import ScrollAnimations from '../components/scripts/ScrollAnimations.astro';
import '../styles/global.css';
import { CONTACTS } from '../data/contacts';

export interface Props {
  title: string;
  description: string;
  canonicalUrl?: string;
  structuredData?: object;
  faqData?: Array<{ question: string; answer: string }>;
  lang?: 'ru' | 'fi' | 'en';
}

const {
  title,
  description,
  canonicalUrl = new URL(Astro.url.pathname, Astro.site).href,
  structuredData,
  faqData = [],
  lang = 'ru',
} = Astro.props;

// Определяем, относится ли страница к переводам
const isTranslation =
  Astro.url.pathname.startsWith('/translation') ||
  Astro.url.pathname.startsWith('/fi') ||
  Astro.url.pathname.startsWith('/en');

const siteUrl = 'https://konopelko.com';
const fullOgImage = siteUrl + '/images/grigori.webp';

const siteNames = {
  ru: isTranslation
    ? 'Переводчик финского языка — Григорий Конопелько'
    : 'Репетитор финского языка — Григорий Конопелько',
  fi: 'Venäjän kielen kääntäjä ja tulkki — Grigori Konopelko',
  en: 'Finnish-Russian-English Translator & Interpreter — Grigori Konopelko',
};

const ogLocales = {
  ru: 'ru_RU',
  fi: 'fi_FI',
  en: 'en_US',
};

const siteName = siteNames[lang];

const jsonLdString = JSON.stringify(
  structuredData || {
    '@context': 'https://schema.org',
    '@type': 'ProfessionalService',
    name: siteName,
    description: description,
    url: new URL(Astro.url.pathname, Astro.site).href,
    telephone: CONTACTS.phone.display,
    email: CONTACTS.email.display,
    address: {
      '@type': 'PostalAddress',
      addressCountry: 'RU',
      addressLocality: 'Санкт-Петербург',
    },
    areaServed: ['Россия', 'Финляндия'],
    serviceType: isTranslation ? 'Услуги устного и письменного переводчика' : 'Языковые курсы',
    provider: {
      '@type': 'Person',
      name: 'Григорий Конопелько',
      jobTitle: isTranslation ? 'Переводчик финского языка' : 'Репетитор финского языка',
      experienceYears: '15',
    },
  }
);

const faqStructuredData =
  faqData.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: faqData.map((q) => ({
          '@type': 'Question',
          name: q.question,
          acceptedAnswer: {
            '@type': 'Answer',
            text: q.answer.replace(/<[^>]*>/g, ''),
          },
        })),
      }
    : null;

const cleanPath = Astro.url.pathname.replace(/^\/translation(\/(fi|en))?/, '') || '/';
const sharedPaths = ['/', '/interpreting/', '/written/', '/price/', '/contact/'];
const hasAllLanguages = isTranslation && sharedPaths.includes(cleanPath);

const hreflangRu = new URL(`/translation${cleanPath}`, Astro.site).href;
const hreflangFi = new URL(`/translation/fi${cleanPath}`, Astro.site).href;
const hreflangEn = new URL(`/translation/en${cleanPath}`, Astro.site).href;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {
      hasAllLanguages && (
        <>
          <link rel="alternate" hreflang="ru" href={hreflangRu} />
          <link rel="alternate" hreflang="fi" href={hreflangFi} />
          <link rel="alternate" hreflang="en" href={hreflangEn} />
          <link rel="alternate" hreflang="x-default" href={hreflangRu} />
        </>
      )
    }

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={fullOgImage} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content={ogLocales[lang]} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={fullOgImage} />

    <!-- Аналитика -->
    <Analytics />

    <meta name="yandex-verification" content="7cd2bf4f92125340" />
    <link rel="icon" href={favicon.src} type="image/svg+xml" />

    <!-- Предзагрузка главного изображения -->
    <link rel="preload" as="image" href="/images/grigori.webp" fetchpriority="high" />

    <!-- Структурированные данные -->
    <script is:inline type="application/ld+json" set:html={jsonLdString} />

    {
      faqStructuredData && (
        <script is:inline type="application/ld+json" set:html={JSON.stringify(faqStructuredData)} />
      )
    }

    <!-- Критический CSS -->
    <style>
      .body-wrapper {
        background: var(--background-white);
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        margin: 0 auto;
        padding: 0 2rem;
        width: 100%;
        max-width: 75rem;
      }

      .main-container {
        flex: 1;
        display: flex;
        flex-direction: column;
        width: 100%;
        gap: 1rem;
      }

      .hero h1 {
        opacity: 1;
        font-family: var(--font-heading);
        font-size: var(--heading-1);
        font-weight: 700;
      }

      .teacher-photo {
        opacity: 1;
        border-radius: 50%;
        object-fit: cover;
        width: 400px;
        height: 400px;
      }

      h1,
      h2,
      h3 {
        font-family: var(--font-heading);
        color: var(--text-primary);
        font-weight: 600;
        line-height: 1.3;
        text-align: center;
        margin: 0.5em 0;
      }

      @media (max-width: 48rem) {
        .body-wrapper {
          padding: 0 1rem;
        }
        .main-container {
          gap: 0.5rem;
        }
        .teacher-photo {
          width: 300px;
          height: 300px;
        }
      }

      @media (max-width: 26.875rem) {
        .body-wrapper {
          padding: 0 0.5rem;
        }
      }

      @media (max-width: 23.4375rem) {
        .body-wrapper {
          padding: 0 0.25rem;
        }
        .teacher-photo {
          width: 250px;
          height: 250px;
        }
      }
    </style>
  </head>
  <body>
    <div class="body-wrapper">
      <Header />
      <main class="main-container">
        <slot />
      </main>
      <Footer />
    </div>
    <ScrollAnimations />
  </body>
</html>
